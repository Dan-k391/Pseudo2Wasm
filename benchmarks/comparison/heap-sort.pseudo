DECLARE values: ARRAY[0:16383] OF INTEGER
PROCEDURE sift(start: INTEGER, finish: INTEGER)
    DECLARE root: INTEGER
    DECLARE child: INTEGER
    DECLARE temp: INTEGER
    root <- start
    WHILE root * 2 + 1 <= finish
        child <- root * 2 + 1
        IF child < finish THEN
            IF values[child] < values[child + 1] THEN
                child <- child + 1
            ENDIF
        ENDIF
        IF values[root] < values[child] THEN
            temp <- values[root]
            values[root] <- values[child]
            values[child] <- temp
            root <- child
        ELSE
            root <- finish
        ENDIF
    ENDWHILE
ENDPROCEDURE
DECLARE n: INTEGER
DECLARE seed: INTEGER
DECLARE state: INTEGER
DECLARE i: INTEGER
DECLARE temp: INTEGER
DECLARE checksum: INTEGER
INPUT n
INPUT seed
state <- seed
FOR i <- 0 TO n - 1
    state <- (state * 17 + 23) MOD 65521
    values[i] <- state
NEXT i
i <- n DIV 2 - 1
WHILE i >= 0
    CALL sift(i, n - 1)
    i <- i - 1
ENDWHILE
i <- n - 1
WHILE i > 0
    temp <- values[0]
    values[0] <- values[i]
    values[i] <- temp
    CALL sift(0, i - 1)
    i <- i - 1
ENDWHILE
checksum <- 0
FOR i <- 0 TO n - 1
    checksum <- (checksum * 17 + values[i]) MOD 65521
NEXT i
OUTPUT checksum
