{
  "name": "pseudo2wasm",
  "version": "1.2.0",
  "description": "Compile CAIE pseudocode to WebAssembly",
  "main": "./node-entry.cjs",
  "browser": "./dist/pseudo2wasm.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/pseudo2wasm.js",
      "import": "./dist/pseudo2wasm.node.mjs",
      "default": "./node-entry.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "node-entry.cjs",
    "README.md",
    "LANGUAGE_SUPPORT.md",
    "MEMORY_MODEL.md",
    "BENCHMARKS.md"
  ],
  "scripts": {
    "test": "npm run build && npm run build:test && node test/node.test.mjs && node scripts/differential.mjs && node scripts/benchmark.mjs --quick --check && node scripts/run-browser-tests.mjs && node scripts/test-package.mjs",
    "bench": "npm run build:node && node scripts/benchmark.mjs",
    "test:browser": "webpack serve --config webpack.config.js --open",
    "typecheck": "tsc --project tsconfig.json",
    "build": "npm run typecheck && npm run build:browser && npm run build:node && npm run build:types",
    "build:browser": "webpack --config webpack.package.config.js --env target=browser",
    "build:node": "webpack --config webpack.package.config.js --env target=node",
    "build:types": "tsc --project tsconfig.build.json",
    "build:test": "webpack --config webpack.config.js",
    "start": "npm run test:browser",
    "prepack": "npm run build"
  },
  "keywords": [],
  "author": "Dan-k391",
  "license": "ISC",
  "dependencies": {
    "binaryen": "^132.0.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "chai": "^4.3.10",
    "html-webpack-plugin": "^5.5.0",
    "ts-loader": "^9.4.2",
    "typescript": "^5.9.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^4.11.1"
  }
}
